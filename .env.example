# Safe local defaults used by the `quantas-gui` launcher
QUANTAS_GUI_MODE=local
QUANTAS_GUI_HOST=127.0.0.1
QUANTAS_GUI_PORT=8050
QUANTAS_GUI_OPEN_BROWSER=true
QUANTAS_GUI_DEBUG=false
QUANTAS_GUI_URL_PREFIX=/
# QUANTAS_GUI_WORKSPACE=/custom/path/to/workspaces
QUANTAS_GUI_MAX_UPLOAD=268435456
QUANTAS_GUI_RESULT_CACHE_ENTRIES=48
QUANTAS_GUI_WORKSPACE_LOCK_TIMEOUT=300

# WSGI server settings. Use quantas_gui.wsgi:server, not the local launcher.
# QUANTAS_GUI_MODE=server
# QUANTAS_GUI_OPEN_BROWSER=false
# QUANTAS_GUI_DEBUG=false
# QUANTAS_GUI_WORKSPACE=/shared/quantas-gui/workspaces
# QUANTAS_GUI_TRUSTED_HOSTS=quantas.example.org
# QUANTAS_GUI_PROXY_HOPS=1
# QUANTAS_GUI_SECURE_COOKIES=true
